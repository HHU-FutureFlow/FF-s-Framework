            "configFiles": [
                "${workspaceFolder}/openocd_dap.cfg"
            ],
            "searchDir": [
                "${workspaceFolder}",
                "${workspaceFolder}/tools/OpenOCD-20231002-0.12.0/share/openocd/scripts"
            ],
            "preLaunchTask": "debug preflight",
            "postDebugTask": "debug: cleanup stale servers",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "parsed",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
