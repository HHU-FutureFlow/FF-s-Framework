    "configurations": [
        {
            "name": "CMSIS-DAP: Default (Build)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "rtos": "FreeRTOS",
            "servertype": "openocd",
            "serverpath": "${workspaceFolder}/tools/OpenOCD-20231002-0.12.0/bin/openocd.exe",
            "gdbPath": "${workspaceFolder}/tools/gcc-arm-none-eabi-10.3-2021.10/bin/arm-none-eabi-gdb.exe",
