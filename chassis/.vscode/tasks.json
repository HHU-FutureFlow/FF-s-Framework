{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build task",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\mingw64\\bin\\mingw32-make.exe",
            "args": [
                "-j24"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug: prepare workspace",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\prepare-cortex-debug.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug: prepare workspace on folder open",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\prepare-cortex-debug.ps1",
                "-Quiet",
                "-SkipToolValidation",
                "-AggressiveStateReset"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug: cleanup stale servers",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\cleanup-debug-servers.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug preflight",
            "dependsOrder": "sequence",
            "dependsOn": [
                "debug: prepare workspace",
                "build task"
            ],
            "problemMatcher": []
        },
        {
            "label": "debug: list connected probes",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\list-debug-probes.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug: probe test (CMSIS-DAP)",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\OpenOCD-20231002-0.12.0\\bin\\openocd.exe",
            "args": [
                "-d2",
                "-f",
                "${workspaceFolder}\\openocd_dap.cfg",
                "-c",
                "init",
                "-c",
                "reset halt",
                "-c",
                "shutdown"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug: probe test (J-Link)",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\OpenOCD-20231002-0.12.0\\bin\\openocd.exe",
            "args": [
                "-d2",
                "-f",
                "${workspaceFolder}\\openocd_jlink.cfg",
                "-c",
                "init",
                "-c",
                "reset halt",
                "-c",
                "shutdown"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug: probe test (ST-Link)",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\OpenOCD-20231002-0.12.0\\bin\\openocd.exe",
            "args": [
                "-d2",
                "-f",
                "${workspaceFolder}\\openocd_stlink.cfg",
                "-c",
                "init",
                "-c",
                "reset halt",
                "-c",
                "shutdown"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "download dap",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\mingw64\\bin\\mingw32-make.exe",
            "args": [
                "download_dap"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "download jlink",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\mingw64\\bin\\mingw32-make.exe",
            "args": [
                "download_jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
