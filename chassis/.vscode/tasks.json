{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure task",
            "type": "process",
            "command": "C:/mingw64/bin/cmake.exe",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_MAKE_PROGRAM=C:/mingw64/bin/ninja.exe",
                "-DCMAKE_C_COMPILER=D:/ClionToolchains/gcc-arm-none-eabi-10.3-2021.10/bin/arm-none-eabi-gcc.exe",
                "-DCMAKE_ASM_COMPILER=D:/ClionToolchains/gcc-arm-none-eabi-10.3-2021.10/bin/arm-none-eabi-gcc.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "build task",
            "type": "process",
            "command": "C:/mingw64/bin/cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--parallel"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "configure task"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "clean task",
            "type": "process",
            "command": "C:/mingw64/bin/cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug preflight",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build task"
            ],
            "problemMatcher": []
        },
        {
            "label": "debug: cleanup stale servers",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/cleanup-debug-servers.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug: list connected probes",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/list-debug-probes.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug: probe test (CMSIS-DAP)",
            "type": "process",
            "command": "D:/ClionToolchains/OpenOCD-20231002-0.12.0/bin/openocd.exe",
            "args": [
                "-d2",
                "-f",
                "${workspaceFolder}/openocd_dap.cfg",
                "-c",
                "init",
                "-c",
                "reset halt",
                "-c",
                "shutdown"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "debug: probe test (ST-Link)",
            "type": "process",
            "command": "D:/ClionToolchains/OpenOCD-20231002-0.12.0/bin/openocd.exe",
            "args": [
                "-d2",
                "-f",
                "${workspaceFolder}/openocd_stlink.cfg",
                "-c",
                "init",
                "-c",
                "reset halt",
                "-c",
                "shutdown"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "download dap",
            "type": "process",
            "command": "D:/ClionToolchains/OpenOCD-20231002-0.12.0/bin/openocd.exe",
            "args": [
                "-f",
                "${workspaceFolder}/openocd_dap.cfg",
                "-c",
                "init",
                "-c",
                "reset halt",
                "-c",
                "flash write_image erase build/basic_framework.bin 0x08000000",
                "-c",
                "reset",
                "-c",
                "shutdown"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "build task"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "download stlink",
            "type": "process",
            "command": "D:/ClionToolchains/OpenOCD-20231002-0.12.0/bin/openocd.exe",
            "args": [
                "-f",
                "${workspaceFolder}/openocd_stlink.cfg",
                "-c",
                "init",
                "-c",
                "reset halt",
                "-c",
                "flash write_image erase build/basic_framework.bin 0x08000000",
                "-c",
                "reset",
                "-c",
                "shutdown"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "build task"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
